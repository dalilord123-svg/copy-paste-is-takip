// ============================================
// DOSYA KATEGORİLERİ
// ============================================

enum FileCategory {
  TASARIM
  PDF
  GORSEL
  FOTOGRAF
  SOZLESME
  DIGER
}

// ============================================
// PERSONEL ROLLERİ
// ============================================

enum EmployeeRole {
  ADMIN
  YONETICI
  GRAFIK
  URETIM
  MONTAJ
}

// ============================================
// ÖNCELİK
// ============================================

enum JobPriority {
  DUSUK
  NORMAL
  YUKSEK
  ACIL
}
